NODE_ENV=production
PORT=3000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lanzou_hub
DB_USER=lanzou_hub
DB_PASSWORD=change_me

# Redis (用于直链缓存 + API Key 限流；不再存 session)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=please_change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# 首次初始化管理员
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=Admin@123456

# 直链缓存（秒）。蓝奏直链 8~24h 过期不等，缓存取保守值
LINK_CACHE_TTL=1800

# 对外 API 全局默认限流（按 key，每分钟次数）
API_RATE_LIMIT_PER_MIN=60

# 千万级第一阶段优化参数（可选）
DB_POOL_LIMIT=30
API_KEY_CACHE_TTL=300
API_LOG_FLUSH_INTERVAL_MS=2000
API_LOG_FLUSH_BATCH=500
API_LOG_QUEUE_MAX=20000
API_LOG_RAW_ENABLED=1
STATS_CACHE_TTL=60
STATS_TREND_CACHE_TTL=300
STATS_RESOURCE_EXACT=0

# 亿级搜索外置（可选）
SEARCH_ENGINE=mysql
SEARCH_URL=
SEARCH_USERNAME=
SEARCH_PASSWORD=
SEARCH_INDEX=lrh_resources
SEARCH_SHARDS=3
SEARCH_REPLICAS=0
SEARCH_TIMEOUT_MS=5000
SEARCH_BULK_BATCH=1000
