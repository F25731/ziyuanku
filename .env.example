NODE_ENV=production
PORT=3000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lanzou_hub
DB_USER=lanzou_hub
DB_PASSWORD=change_me

# Redis (用于直链缓存 + API Key 限流；不再存 session)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Meilisearch（百万级秒搜索）
# Docker 部署时 host=http://meilisearch:7700；非 Docker 本机部署填 http://127.0.0.1:7700
MEILI_HOST=http://127.0.0.1:7700
MEILI_KEY=

# JWT
JWT_SECRET=please_change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# 首次初始化管理员
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=Admin@123456

# 直链缓存（秒）。蓝奏直链 8~24h 过期不等，缓存取保守值
LINK_CACHE_TTL=1800

# 对外 API 全局默认限流（按 key，每分钟次数）
API_RATE_LIMIT_PER_MIN=60
