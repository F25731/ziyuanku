NODE_ENV=production
PORT=3000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lanzou_hub
DB_USER=lanzou_hub
DB_PASSWORD=change_me
DB_POOL_LIMIT=30

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=please_change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Initial admin
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=Admin@123456

# Link cache and API limits
LINK_CACHE_TTL=1800
API_RATE_LIMIT_PER_MIN=60
API_KEY_CACHE_TTL=300

# Async API logs and dashboard stats
API_LOG_FLUSH_INTERVAL_MS=2000
API_LOG_FLUSH_BATCH=500
API_LOG_QUEUE_MAX=20000
API_LOG_RAW_ENABLED=1
STATS_CACHE_TTL=60
STATS_TREND_CACHE_TTL=300
STATS_RESOURCE_EXACT=0

# Search
SEARCH_ENGINE=mysql
MANTICORE_URL=
MANTICORE_INDEX=lrh_resources
MANTICORE_BATCH_SIZE=1000
MANTICORE_RETRY_ATTEMPTS=5
MANTICORE_MAX_MATCHES=20000
SEARCH_TIMEOUT_MS=5000
SEARCH_CACHE_ENABLED=1
SEARCH_CACHE_TTL=60
SEARCH_CACHE_HOT_TTL=600
SEARCH_CACHE_HOT_MIN=3
SEARCH_MIN_QUERY_LEN=2
SEARCH_REQUIRE_EXTERNAL=0
SEARCH_OUTBOX_WORKER_ENABLED=1
SEARCH_OUTBOX_BATCH=500
SEARCH_OUTBOX_INTERVAL_MS=5000
SEARCH_OUTBOX_MAX_ATTEMPTS=10
SEARCH_REINDEX_BATCH=2000

# Sync and cleanup batches
RECONCILE_DELETE_BATCH=5000
RESOURCE_META_BACKFILL_BATCH=5000
SYNC_UPSERT_BATCH=200
SYNC_MAX_INDEX_DEPTH=20
