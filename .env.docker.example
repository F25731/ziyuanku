# Docker Compose 专用环境变量样例
# 用法：cp .env.docker.example .env  然后修改下面的值
# 注意：.env 已在 .gitignore 中，不会被提交

# ===== 必改 =====
# 应用数据库用户密码（app 连 mysql 用）
DB_PASSWORD=please_change_me_db_password
# MySQL root 密码（初始化容器用）
MYSQL_ROOT_PASSWORD=please_change_me_root_password
# JWT 密钥（建议 64 位随机字符串；Linux 上可 `openssl rand -hex 32`）
JWT_SECRET=please_change_me_to_a_long_random_string

# ===== 管理员初始账号（首次启动时自动创建）=====
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=Admin@123456

# ===== 可选 =====
# 宿主机映射端口（浏览器访问的端口；Nginx 反代时改成 127.0.0.1 专用端口）
APP_PORT=3000

# 直链缓存秒数（蓝奏直链 30 分钟内稳定，保守取 1800）
LINK_CACHE_TTL=1800

# 每个 API Key 默认每分钟限流
API_RATE_LIMIT_PER_MIN=60

# ===== 千万级第一阶段优化参数（可选，不填用默认）=====
# MySQL 连接池大小
DB_POOL_LIMIT=30
# API Key 校验成功后缓存秒数，减少 bcrypt 和数据库查询
API_KEY_CACHE_TTL=300
# API 调用日志异步批量写库
API_LOG_FLUSH_INTERVAL_MS=2000
API_LOG_FLUSH_BATCH=500
API_LOG_QUEUE_MAX=20000
# 1=保留原始明细日志；亿级高 QPS 可改 0，只保留小时聚合
API_LOG_RAW_ENABLED=1
# 后台仪表盘统计缓存秒数
STATS_CACHE_TTL=60
STATS_TREND_CACHE_TTL=300
# 0=资源总数走 information_schema 估算；1=精确 COUNT(*)，大表慎开
STATS_RESOURCE_EXACT=0

# ===== 轻量搜索外置（可选，不配置则继续使用 MySQL FULLTEXT）=====
# 启用 docker-compose.search.yml 时使用 Manticore，只索引 id/file_name/source_id/file_type
SEARCH_ENGINE=mysql
MANTICORE_URL=
MANTICORE_INDEX=lrh_resources
MANTICORE_BATCH_SIZE=1000
MANTICORE_RETRY_ATTEMPTS=5
MANTICORE_MAX_MATCHES=20000
SEARCH_TIMEOUT_MS=5000
# 搜索短缓存：相同关键词/游标/权限范围 60 秒内直接走 Redis，降低重复搜索压力
SEARCH_CACHE_ENABLED=1
SEARCH_CACHE_TTL=60
# 热门搜索命中 3 次后缓存 10 分钟
SEARCH_CACHE_HOT_TTL=600
SEARCH_CACHE_HOT_MIN=3
# 亿级数据下不建议允许单字搜索；如必须兼容单字搜索可改 1
SEARCH_MIN_QUERY_LEN=2
# 1=关键词搜索必须走外部搜索；外部搜索不可用时直接 503，不回落 MySQL
SEARCH_REQUIRE_EXTERNAL=0
# 搜索索引 outbox worker；启用 docker-compose.search.yml 时会由独立 search-worker 进程运行
SEARCH_OUTBOX_WORKER_ENABLED=1
SEARCH_OUTBOX_BATCH=500
SEARCH_OUTBOX_INTERVAL_MS=5000
SEARCH_OUTBOX_MAX_ATTEMPTS=10
# 全量同步后标记删除的分批大小，避免大事务长时间锁表
RECONCILE_DELETE_BATCH=5000
RESOURCE_META_BACKFILL_BATCH=5000
